generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Platform-level: users, stores, membership, RBAC
// ─────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String? // null when the account only uses OAuth
  name          String?
  avatarUrl     String?
  isSuperAdmin  Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  memberships   StoreMember[]
  ownedStores   Store[]        @relation("StoreOwner")
  notifications Notification[]
  auditLogs     AuditLog[]

  @@index([email])
}

// Auth.js adapter models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum StoreRole {
  OWNER
  MANAGER
  STAFF
}

model Store {
  id                  String    @id @default(cuid())
  name                String
  slug                String    @unique
  customDomain        String?   @unique
  category            String?
  businessType        String?
  country             String?
  defaultCurrency     String    @default("USD")
  supportedCurrencies String[]  @default(["USD"])
  defaultLocale       String    @default("en")
  supportedLocales    String[]  @default(["en"])
  logoUrl             String?
  faviconUrl          String?
  isPublished         Boolean   @default(false)
  ownerId             String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  owner User @relation("StoreOwner", fields: [ownerId], references: [id])

  members            StoreMember[]
  products           Product[]
  categories         Category[]
  inventoryLocations InventoryLocation[]
  orders             Order[]
  customers          Customer[]
  carts              Cart[]
  discounts          Discount[]
  coupons            Coupon[]
  reviews            Review[]
  pages              Page[]
  themes             Theme[]
  media              Media[]
  analyticsEvents    AnalyticsEvent[]
  notifications      Notification[]
  automations        Automation[]
  webhooks           Webhook[]
  apiKeys            ApiKey[]
  subscription       Subscription?
  shippingZones      ShippingZone[]
  taxRates           TaxRate[]
  auditLogs          AuditLog[]

  @@index([ownerId])
}

model StoreMember {
  id        String    @id @default(cuid())
  storeId   String
  userId    String
  role      StoreRole @default(STAFF)
  createdAt DateTime  @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  storeId   String?
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Catalog
// ─────────────────────────────────────────────────────────────────────────

model Category {
  id             String   @id @default(cuid())
  storeId        String
  name           String
  slug           String
  description    String?
  imageUrl       String?
  parentId       String?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  store    Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent   Category?         @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[]        @relation("CategoryTree")
  products ProductCategory[]

  @@unique([storeId, slug])
  @@index([storeId])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id             String        @id @default(cuid())
  storeId        String
  name           String
  slug           String
  description    String?
  status         ProductStatus @default(DRAFT)
  brand          String?
  tags           String[]      @default([])
  seoTitle       String?
  seoDescription String?
  weightGrams    Int?
  widthMm        Int?
  heightMm       Int?
  depthMm        Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  store      Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categories ProductCategory[]
  variants   ProductVariant[]
  images     Media[]
  reviews    Review[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([storeId, slug])
  @@index([storeId, status])
}

model ProductCategory {
  productId  String
  categoryId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  name           String // e.g. "Red / Large"
  sku            String?
  barcode        String?
  priceCents     Int
  compareAtCents Int?
  costCents      Int?
  attributes     Json // { color: "Red", size: "L" }
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryItems InventoryItem[]
  cartItems      CartItem[]
  orderItems     OrderItem[]

  @@unique([productId, sku])
  @@index([productId])
}

model Media {
  id        String   @id @default(cuid())
  storeId   String
  productId String?
  url       String
  type      String   @default("image") // image | video
  altText   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  store   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([productId])
}

// ─────────────────────────────────────────────────────────────────────────
// Inventory
// ─────────────────────────────────────────────────────────────────────────

model InventoryLocation {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  address   String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  store          Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  inventoryItems InventoryItem[]
  transfersFrom  InventoryTransfer[] @relation("TransferFrom")
  transfersTo    InventoryTransfer[] @relation("TransferTo")

  @@index([storeId])
}

model InventoryItem {
  id                String   @id @default(cuid())
  variantId         String
  locationId        String
  quantity          Int      @default(0)
  lowStockThreshold Int      @default(5)
  updatedAt         DateTime @updatedAt

  variant  ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location InventoryLocation  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  history  InventoryHistory[]

  @@unique([variantId, locationId])
  @@index([locationId])
}

enum InventoryChangeReason {
  SALE
  RESTOCK
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  RETURN
}

model InventoryHistory {
  id              String                @id @default(cuid())
  inventoryItemId String
  change          Int // signed delta
  reason          InventoryChangeReason
  note            String?
  createdAt       DateTime              @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId, createdAt])
}

model InventoryTransfer {
  id             String   @id @default(cuid())
  fromLocationId String
  toLocationId   String
  quantity       Int
  status         String   @default("pending") // pending | in_transit | completed
  createdAt      DateTime @default(now())

  fromLocation InventoryLocation @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocation   InventoryLocation @relation("TransferTo", fields: [toLocationId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────
// Customers, carts
// ─────────────────────────────────────────────────────────────────────────

model Customer {
  id               String    @id @default(cuid())
  storeId          String
  email            String
  firstName        String?
  lastName         String?
  phone            String?
  passwordHash     String?
  acceptsMarketing Boolean   @default(false)
  tags             String[]  @default([])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  addresses Address[]
  orders    Order[]
  carts     Cart[]
  reviews   Review[]

  @@unique([storeId, email])
  @@index([storeId])
}

model Address {
  id         String  @id @default(cuid())
  customerId String
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String?
  country    String
  phone      String?
  isDefault  Boolean @default(false)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Cart {
  id                   String    @id @default(cuid())
  storeId              String
  customerId           String?
  currency             String    @default("USD")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  abandonedEmailSentAt DateTime?

  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    CartItem[]

  @@index([storeId])
  @@index([customerId])
}

model CartItem {
  id            String  @id @default(cuid())
  cartId        String
  productId     String
  variantId     String
  quantity      Int     @default(1)
  savedForLater Boolean @default(false)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
}

// ─────────────────────────────────────────────────────────────────────────
// Orders, payments, shipments
// ─────────────────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum ShippingStatus {
  UNFULFILLED
  FULFILLED
  IN_TRANSIT
  DELIVERED
}

model Order {
  id              String         @id @default(cuid())
  storeId         String
  customerId      String?
  orderNumber     Int            @default(autoincrement())
  status          OrderStatus    @default(PENDING)
  paymentStatus   PaymentStatus  @default(PENDING)
  shippingStatus  ShippingStatus @default(UNFULFILLED)
  currency        String         @default("USD")
  subtotalCents   Int
  discountCents   Int            @default(0)
  shippingCents   Int            @default(0)
  taxCents        Int            @default(0)
  totalCents      Int
  shippingAddress Json?
  billingAddress  Json?
  customerNote    String?
  internalNote    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  store             Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer          Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  payments          Payment[]
  shipments         Shipment[]
  timeline          OrderEvent[]
  couponRedemptions CouponRedemption[]

  @@index([storeId, createdAt])
  @@index([customerId])
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  productId      String
  variantId      String
  name           String // snapshot at time of order
  variantName    String
  quantity       Int
  unitPriceCents Int
  totalCents     Int

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  type      String // status_change | note | email_sent
  message   String
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  provider      String // stripe | paypal | cod | bank_transfer
  providerRef   String? // e.g. Stripe payment_intent id
  status        PaymentStatus @default(PENDING)
  amountCents   Int
  refundedCents Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([providerRef])
}

model Shipment {
  id             String         @id @default(cuid())
  orderId        String
  carrier        String?
  trackingNumber String?
  status         ShippingStatus @default(UNFULFILLED)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ─────────────────────────────────────────────────────────────────────────
// Shipping & tax configuration
// ─────────────────────────────────────────────────────────────────────────

model ShippingZone {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  countries String[]
  createdAt DateTime @default(now())

  store   Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  methods ShippingMethod[]

  @@index([storeId])
}

enum ShippingRateType {
  FLAT
  FREE
  WEIGHT_BASED
  PRICE_BASED
}

model ShippingMethod {
  id               String           @id @default(cuid())
  zoneId           String
  name             String
  type             ShippingRateType @default(FLAT)
  priceCents       Int              @default(0)
  minOrderCents    Int?
  minWeightGrams   Int?
  maxWeightGrams   Int?
  estimatedDaysMin Int?
  estimatedDaysMax Int?

  zone ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId])
}

model TaxRate {
  id           String  @id @default(cuid())
  storeId      String
  country      String
  region       String?
  ratePermille Int // rate in 1/1000 of a percent unit-free integer, e.g. 8.25% = 8250

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

// ─────────────────────────────────────────────────────────────────────────
// Discounts
// ─────────────────────────────────────────────────────────────────────────

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
  BUY_X_GET_Y
}

model Discount {
  id                   String       @id @default(cuid())
  storeId              String
  name                 String
  type                 DiscountType
  valueCents           Int? // for FIXED_AMOUNT
  valuePercent         Int? // for PERCENTAGE (0-100)
  buyQuantity          Int? // for BUY_X_GET_Y
  getQuantity          Int? // for BUY_X_GET_Y
  appliesToProductIds  String[]     @default([])
  appliesToCategoryIds String[]     @default([])
  startsAt             DateTime?
  endsAt               DateTime?
  isActive             Boolean      @default(true)
  createdAt            DateTime     @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, isActive])
}

model Coupon {
  id               String       @id @default(cuid())
  storeId          String
  code             String
  type             DiscountType
  valueCents       Int?
  valuePercent     Int?
  minOrderCents    Int?
  usageLimit       Int?
  usageCount       Int          @default(0)
  perCustomerLimit Int?
  customerIds      String[]     @default([]) // empty = all customers
  startsAt         DateTime?
  endsAt           DateTime?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())

  store       Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  redemptions CouponRedemption[]

  @@unique([storeId, code])
  @@index([storeId, isActive])
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  orderId   String
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([orderId])
}

// ─────────────────────────────────────────────────────────────────────────
// Reviews, storefront pages, themes
// ─────────────────────────────────────────────────────────────────────────

model Review {
  id          String   @id @default(cuid())
  storeId     String
  productId   String
  customerId  String?
  rating      Int
  title       String?
  body        String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([storeId])
}

model Page {
  id             String   @id @default(cuid())
  storeId        String
  title          String
  slug           String
  sections       Json // ordered array of {type, props} — store-builder sections
  seoTitle       String?
  seoDescription String?
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, slug])
  @@index([storeId])
}

model Theme {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  tokens    Json // colors, typography, spacing, radii
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

// ─────────────────────────────────────────────────────────────────────────
// Analytics, notifications, marketing automation
// ─────────────────────────────────────────────────────────────────────────

model AnalyticsEvent {
  id        String   @id @default(cuid())
  storeId   String
  type      String // page_view | add_to_cart | checkout_started | order_placed
  metadata  Json?
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, type, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  storeId   String?
  userId    String
  type      String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model Automation {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  trigger   String // e.g. cart_abandoned, customer_created
  steps     Json // ordered [{wait: "2h"}, {action: "send_email", template: "..."}]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

// ─────────────────────────────────────────────────────────────────────────
// Developer platform
// ─────────────────────────────────────────────────────────────────────────

model Webhook {
  id        String   @id @default(cuid())
  storeId   String
  url       String
  events    String[]
  secret    String // used to sign X-Nova-Signature
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model ApiKey {
  id         String    @id @default(cuid())
  storeId    String
  name       String
  hashedKey  String    @unique
  keyPrefix  String // shown to the user, e.g. nova_live_ab12
  scopes     String[]
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

// ─────────────────────────────────────────────────────────────────────────
// SaaS billing
// ─────────────────────────────────────────────────────────────────────────

enum PlanTier {
  FREE
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
}

model Subscription {
  id                   String             @id @default(cuid())
  storeId              String             @unique
  plan                 PlanTier           @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  billingPeriod        String             @default("monthly") // monthly | yearly
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}
