# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nova_commerce?schema=public"

# Redis (queues, caching, rate limiting)
REDIS_URL="redis://localhost:6379"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Object storage (S3-compatible)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="nova-commerce-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# Payments
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email
RESEND_API_KEY=""
EMAIL_FROM="NOVA <no-reply@example.com>"

# AI
OPENAI_API_KEY=""

# Platform
PLATFORM_ROOT_DOMAIN="platform.com"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
